DATABASE_URL=postgresql+asyncpg://studio:studio@postgres:5432/studio
REDIS_URL=redis://redis:6379/0

# Generate a long random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

COOKIE_SECURE=false
COOKIE_PATH=/studio

DATA_DIR=/data
# Absolute path on the Docker host that is mounted as ./data in this repo.
HOST_DATA_DIR=/absolute/path/to/latex-studio/data

COMPILE_IMAGE=tectonic-prod:0.17.0
COMPILE_TEXLIVE_IMAGE=overleaf-latex-full:6.3.2
COMPILE_TIMEOUT_SECONDS=600

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
